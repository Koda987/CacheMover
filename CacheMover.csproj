<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CacheMover</AssemblyName>
    <RootNamespace>CacheMover</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <AssemblyTitle>缓存搬家 CacheMover</AssemblyTitle>
    <Product>缓存搬家 CacheMover</Product>
    <Description>用目录联接把 C 盘软件缓存安全迁移到其他盘，无需管理员权限</Description>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>

    <!-- 免安装：自包含单文件发布，dotnet publish 后得到一个可直接双击运行的 exe -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- 「修改」目录是布局参考稿，不参与编译 -->
    <Compile Remove="修改\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\bg.jpg" />
    <EmbeddedResource Include="assets\mascot.png" />
  </ItemGroup>

</Project>
